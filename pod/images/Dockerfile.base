# concept-captioner pod base image (POD-SPEC §6.1). Build context: the repository root.
#
#   docker buildx build --platform=linux/amd64 -f pod/images/Dockerfile.base \
#       -t concept-captioner-pod-base:dev .
#
# Layers, least- to most-frequently changing, so a code change never rebuilds the heavy ones:
#   1. nvidia/cuda runtime (pinned by digest)      5. /opt/seedvr2 + /opt/venvs/seedvr2 : SeedVR2 upscaling
#   2. apt: git, curl, gcc, ffmpeg, libGL          6. /opt/venvs/agent : podagent[pod] + concept-captioner[hf]
#   3. uv (pinned)                                 7. /opt/pod/scripts/*.py, /opt/pod/entrypoint.sh
#   4. CPython 3.12 under /opt/python (one interpreter for every venv, trainer images included)
#
# No vLLM here: a trainer image built on this base has no caption server. Dockerfile.captioning
# adds /opt/venvs/vllm on top of a finished trainer image, as that image's "-captioning" tag.
#
# Rules kept here: every version is pinned and every pin says what it is and why; nothing secret is
# read at build time; HF_HOME is not baked (the entrypoint points it into /workspace); package
# caches are off. Docker is not available on the development machine, so this file is reviewed by
# eye and built in CI. Lines marked VERIFY are assumptions to confirm on a real pod; images/README.md
# keeps the list and the record of every pin.

# --- pins (images/README.md says how each was chosen) ---------------------------------------------
# nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04: the manifest-list digest Docker Hub served on
# 2026-10-10 (the amd64 image inside it is sha256:59e0e4376a0f16d1…). The system CUDA is used for
# nvidia-smi and the captioning variant's optional JIT toolchain only; every venv carries its own
# CUDA libraries via pip.
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04@sha256:17e2934e1fa96152b14f78078bfbafd0f00f391df995dc6c641a720fce1202bb
# uv 0.12.21 (2026-09-29): more than a week old at the time of writing, and its bundled interpreter
# registry (crates/uv-python/download-metadata.json at that tag) lists CPython 3.12.14 below.
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.21

# The image is x86_64 by construction (CUDA, vLLM and the trainer wheels exist for nothing else), so
# the platform is stated on every FROM: a build on an Apple Silicon machine then needs no extra flag
# and the uv binary copied below is the amd64 one. hadolint DL3029 is a deliberate exception here.
FROM --platform=linux/amd64 ${UV_IMAGE} AS uv
FROM --platform=linux/amd64 ${CUDA_IMAGE} AS base

LABEL org.opencontainers.image.title="concept-captioner-pod-base" \
      org.opencontainers.image.description="CUDA runtime, podagent and concept-captioner for concept-captioner GPU pods" \
      org.opencontainers.image.source="https://github.com/RationallyPrime/concept-captioner" \
      org.opencontainers.image.licenses="MIT"

# Build-time only (an ENV would leak into the pod's own apt): non-interactive apt.
ARG DEBIAN_FRONTEND=noninteractive

# LANG/PYTHONUNBUFFERED: plain UTF-8 logs that stream. The UV_* settings apply to every uv call in
# this file and in the trainer images: managed interpreters under /opt/python, no cache directory
# left in a layer, copy instead of hardlink across the overlay filesystem, bytecode compiled at
# install time (faster cold starts; vLLM has thousands of modules), no progress bars in CI logs.
# HF_HUB_DISABLE_TELEMETRY: no usage pings from the pod. HF_HOME is set by the entrypoint, not here.
ENV LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_PROGRESS=1 \
    HF_HUB_DISABLE_TELEMETRY=1

# System packages. apt versions are deliberately not pinned: Ubuntu's archive keeps only the current
# security build of each package, so a `=version` pin breaks the build at the next security update;
# the base digest above pins everything beneath this layer and this layer tracks jammy-updates.
#   ca-certificates, curl, git : clones and wheel downloads at build time, Hub transfers at run time
#   build-essential            : gcc for Triton's runtime launcher stubs and torch JIT extensions
#   ffmpeg                     : shared libav* for torchcodec (vLLM audio/video inputs; torchcodec
#                                0.15 accepts FFmpeg 4–8, jammy ships 4.4), scenedetect, imageio
#   libgl1, libglib2.0-0       : opencv-python, which both trainers pull in
#   tini                       : PID 1 in the container (entrypoint.sh); reaps the orphans the
#                                supervisor's process-group bookkeeping depends on
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      build-essential \
      ffmpeg \
      libgl1 \
      libglib2.0-0 \
      tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

# CPython 3.12.14 from python-build-standalone: the newest 3.12 the pinned uv can install (3.12.15
# was released 2026-09-30, after uv 0.12.21's registry was cut). POD_PYTHON lets the trainer images
# create their venvs from the same interpreter without repeating the number.
ARG PYTHON_VERSION=3.12.14
ENV POD_PYTHON=${PYTHON_VERSION}
RUN uv python install "${PYTHON_VERSION}"

# --- /opt/seedvr2 and /opt/venvs/seedvr2 ---------------------------------------------------------
# SeedVR2 upscaling and restoration (the upscale-media service, scripts/upscale_media.py), in the
# base so every trainer image can fix the person's images and clips before training. The program is
# the standalone command line of numz/ComfyUI-SeedVR2_VideoUpscaler (Apache-2.0), which runs the
# ByteDance-Seed SeedVR2 models (Apache-2.0) with BlockSwap, VAE tiling and FP8/GGUF support:
#   v2.5.23 = 5a4bf428f3735cc72ac760d40f372f94dec28422 (2025-12-24), the newest release at pin time.
# Its requirements.txt is unpinned; the versions below are what `uv pip compile` resolved from it on
# 2026-10-22 with --exclude-newer 2025-12-24 (the release date, so the stack is the one the release
# was tested against), except torch 2.9.1+cu130 / torchvision 0.24.1+cu130, the torch line of that
# month on the CUDA 13.0 index the trainers already need (R580+ hosts). opencv-python-headless
# replaces opencv-python: the same cv2 without the desktop GUI libraries. Weights are not baked in:
# the command line downloads them, SHA-256-checked, to /workspace/models/seedvr2 on first use.
# VERIFY: first build and a hosted image/clip run (images/README.md).
ARG SEEDVR2_REPO=https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler.git
ARG SEEDVR2_COMMIT=5a4bf428f3735cc72ac760d40f372f94dec28422
ARG SEEDVR2_CUDA=cu130
ARG SEEDVR2_TORCH="torch==2.9.1+cu130 torchvision==0.24.1+cu130"
ARG SEEDVR2_REQUIREMENTS="safetensors==0.7.0 numpy==2.3.5 tqdm==4.67.1 psutil==7.2.0 einops==0.8.1 omegaconf==2.3.0 diffusers==0.36.0 peft==0.18.0 rotary-embedding-torch==0.8.9 opencv-python-headless==4.11.0.86 gguf==0.17.1 matplotlib==3.10.8"
RUN git init -q /opt/seedvr2 \
 && git -C /opt/seedvr2 remote add origin "${SEEDVR2_REPO}" \
 && git -C /opt/seedvr2 fetch -q --depth 1 origin "${SEEDVR2_COMMIT}" \
 && git -C /opt/seedvr2 checkout -q --detach FETCH_HEAD \
 && git -C /opt/seedvr2 log -1 --format='seedvr2 %H %cs %s' \
 && test -f /opt/seedvr2/inference_cli.py \
 && uv venv --python "${PYTHON_VERSION}" /opt/venvs/seedvr2 \
 && uv pip install --python /opt/venvs/seedvr2/bin/python \
      --extra-index-url "https://download.pytorch.org/whl/${SEEDVR2_CUDA}" --index-strategy unsafe-best-match \
      ${SEEDVR2_TORCH} ${SEEDVR2_REQUIREMENTS} \
 && /opt/venvs/seedvr2/bin/python -c "import torch, diffusers, cv2, gguf, rotary_embedding_torch; v = torch.__version__; assert v == '2.9.1+${SEEDVR2_CUDA}', v; print('seedvr2 torch', v, 'diffusers', diffusers.__version__, 'cv2', cv2.__version__)" \
 && cd /opt/seedvr2 && /opt/venvs/seedvr2/bin/python inference_cli.py --help > /dev/null \
 && uv pip freeze --python /opt/venvs/seedvr2/bin/python > /opt/venvs/seedvr2/freeze.txt

# --- /opt/venvs/agent ------------------------------------------------------------------------------
# podagent with its [pod] extra (tensorboard, huggingface_hub, datasets, Pillow) and
# concept-captioner[hf], both from this checkout and both installed as regular (non-editable)
# packages. No torch in this venv. The two pyprojects bound the resolution; the exact set that
# landed is written to /opt/venvs/agent/freeze.txt for the record. README.md is copied because
# hatchling reads `readme = "README.md"` when it builds each package.
COPY pyproject.toml README.md LICENSE /opt/src/concept-captioner/
COPY src/ /opt/src/concept-captioner/src/
COPY pod/agent/pyproject.toml pod/agent/README.md /opt/src/podagent/
COPY pod/agent/src/ /opt/src/podagent/src/
RUN uv venv --python "${PYTHON_VERSION}" /opt/venvs/agent \
 && uv pip install --python /opt/venvs/agent/bin/python \
      "podagent[pod] @ file:///opt/src/podagent" \
      "concept-captioner[hf] @ file:///opt/src/concept-captioner" \
 && /opt/venvs/agent/bin/python -c "import podagent, concept_captioner, tensorboard, huggingface_hub, datasets, PIL; print('podagent', podagent.__version__, 'concept-captioner', concept_captioner.__version__)" \
 && /opt/venvs/agent/bin/python -m podagent --help > /dev/null \
 && uv pip freeze --python /opt/venvs/agent/bin/python > /opt/venvs/agent/freeze.txt

# --- scripts and entrypoint ------------------------------------------------------------------------
# Only the programs: pod/scripts/tests/ and its README stay out of the image. Each script must answer
# --help from a bare interpreter (the scripts README contract: nothing heavy at import time), which
# is checked here so a broken script fails the build rather than the first service start.
COPY pod/scripts/*.py /opt/pod/scripts/
COPY app/Sources/ConceptStudio/Resources/Training/h3-recipe-fields.json /opt/pod/scripts/h3-recipe-fields.json
# The model table (the app's own file); the scripts and the agent read it as /opt/pod/scripts/model-table.json.
COPY app/Sources/ConceptStudio/Resources/Training/model-table.json /opt/pod/scripts/model-table.json
# One LTX rule file (preprocess allowlist, pinned Hub source) for the API and the isolated wrapper.
COPY pod/agent/src/podagent/ltx_rules.py /opt/pod/agent/src/podagent/ltx_rules.py
# One musubi-tuner rule file (what extra.args may set) for the API and the isolated wrapper.
COPY pod/agent/src/podagent/musubi_rules.py /opt/pod/agent/src/podagent/musubi_rules.py
COPY --chmod=0755 pod/images/entrypoint.sh /opt/pod/entrypoint.sh
RUN for script in /opt/pod/scripts/*.py; do \
      /opt/venvs/agent/bin/python -I "$script" --help > /dev/null || exit 1; \
    done

# The network volume is mounted here on RunPod; the entrypoint creates the layout (POD-SPEC §6.4).
WORKDIR /workspace

# 8800 agent: the public HTTP port (the captioning variant adds 8000, vLLM). TensorBoard is behind
# /tensorboard/.
EXPOSE 8800

# Starts the agent and nothing else (POD-SPEC §6.2). Services are started by the app through it.
ENTRYPOINT ["/opt/pod/entrypoint.sh"]
